# EvidenceGuard AI Configuration
# Copy this file to .env and provide your API keys if running against real Google Gemini models.

# LLM Provider: "mock" (default, deterministic offline mode) or "gemini" (real Google Gemini API)
LLM_PROVIDER=mock

# Google Gemini API Key (Required only if LLM_PROVIDER=gemini)
GEMINI_API_KEY=

# Google Gemini Model Name (e.g., gemini-2.5-flash, gemini-1.5-flash, gemini-1.5-pro)
GEMINI_MODEL=gemini-2.5-flash

# Server Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO
