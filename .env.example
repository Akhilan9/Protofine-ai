# EvidenceGuard AI Configuration
# Copy this file to .env and provide your API keys if running against real OpenAI models.

# LLM Provider: "openai" or "mock" (defaults to "openai" if OPENAI_API_KEY is present, otherwise "mock")
LLM_PROVIDER=mock

# OpenAI API Key (Required only if LLM_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here

# Model name (e.g., gpt-4o-mini, gpt-4o)
MODEL_NAME=gpt-4o-mini

# Server Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO
